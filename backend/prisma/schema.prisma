generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String                         @id @default(uuid())
  email                      String                         @unique
  phone                      String                         @unique
  passwordHash               String
  firstName                  String
  lastName                   String
  avatarUrl                  String?
  role                       UserRole                       @default(CLIENT)
  isActive                   Boolean                        @default(true)
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt
  lastLoginAt                DateTime?
  emailVerifiedAt            DateTime?
  phoneVerifiedAt            DateTime?
  countryCode                String                         @default("ES")
  termsAcceptedAt            DateTime?
  termsVersion               String?
  privacyAcceptedAt          DateTime?
  privacyVersion             String?
  marketingConsentAt         DateTime?
  registrationLocale         String?
  marketId                   String?
  clientProfile              ClientProfile?
  notifications              Notification[]
  professionalProfile        ProfessionalProfile?
  reviewsGiven               Review[]                       @relation("ReviewGiven")
  reviewsReceived            Review[]                       @relation("ReviewReceived")
  administrativeRoles        UserRoleAssignment[]
  auditLogs                  AuditLog[]                     @relation("AuditActor")
  marketingEvents            MarketingEvent[]
  errorEvents                ErrorEvent[]
  incidentComments           IncidentComment[]
  adminSessions              AdminSession[]
  customerSessions           CustomerSession[]
  accountActionTokens        AccountActionToken[]
  adminRoleTargets           AdminRoleChangeRequest[]       @relation("AdminRoleTarget")
  adminRoleRequests          AdminRoleChangeRequest[]       @relation("AdminRoleRequester")
  adminRoleReviews           AdminRoleChangeRequest[]       @relation("AdminRoleReviewer")
  supportCasesRequested      SupportCase[]                  @relation("SupportRequester")
  supportCasesAssigned       SupportCase[]                  @relation("SupportAssignee")
  supportCasesCreated        SupportCase[]                  @relation("SupportCreator")
  supportCaseComments        SupportCaseComment[]
  supportCaseEvents          SupportCaseEvent[]
  growthLeads                Lead[]                         @relation("GrowthLeadUser")
  growthConversions          Conversion[]                   @relation("GrowthConversionUser")
  campaignsCreated           Campaign[]                     @relation("CampaignCreator")
  consentPoliciesCreated     ConsentPolicy[]                @relation("ConsentPolicyCreator")
  consentPoliciesReviewed    ConsentPolicy[]                @relation("ConsentPolicyReviewer")
  consentDecisions           ConsentDecision[]
  subjectIdentityLinks       SubjectIdentityLink[]
  privacyTouchpoints         Touchpoint[]
  attributionModelsCreated   AttributionModel[]             @relation("AttributionModelCreator")
  referralProgramsCreated    ReferralProgram[]              @relation("ReferralProgramCreator")
  referralCodesOwned         ReferralCode[]                 @relation("ReferralCodeOwner")
  referralsMade              Referral[]                     @relation("ReferralReferrer")
  referralsReceived          Referral[]                     @relation("ReferralReferred")
  referralRewards            ReferralReward[]               @relation("ReferralRewardBeneficiary")
  automationDefinitions      AutomationDefinition[]         @relation("AutomationDefinitionCreator")
  market                     Market?                        @relation(fields: [marketId], references: [id], onDelete: Restrict)
  addresses                  Address[]
  identityDocuments          IdentityDocument[]
  experimentsCreated         Experiment[]                   @relation("ExperimentCreator")
  contentEntriesCreated      ContentEntry[]                 @relation("ContentEntryCreator")
  contentVersionsCreated     ContentVersion[]               @relation("ContentVersionCreator")
  contentApprovals           ContentApproval[]              @relation("ContentApprover")
  contentPublications        ContentPublication[]           @relation("ContentPublisher")
  seoRedirectsCreated        SeoRedirect[]                  @relation("SeoRedirectCreator")
  supplyDemandDefinitions    SupplyDemandMetricDefinition[] @relation("SupplyDemandDefinitionCreator")
  readinessPoliciesCreated   MarketReadinessPolicy[]        @relation("ReadinessPolicyCreator")
  readinessPoliciesReviewed  MarketReadinessPolicy[]        @relation("ReadinessPolicyReviewer")
  expansionCandidatesCreated ExpansionCandidate[]           @relation("ExpansionCandidateCreator")
  expansionReviews           ExpansionEvaluation[]          @relation("ExpansionReviewer")
  aiProvidersCreated         AIProvider[]                   @relation("AIProviderCreator")
  aiModelPoliciesCreated     AIModelPolicy[]                @relation("AIModelPolicyCreator")
  aiModelPoliciesReviewed    AIModelPolicy[]                @relation("AIModelPolicyReviewer")
  aiPromptTemplatesCreated   AIPromptTemplate[]             @relation("AIPromptTemplateCreator")
  aiPromptVersionsCreated    AIPromptVersion[]              @relation("AIPromptVersionCreator")
  aiPromptVersionsReviewed   AIPromptVersion[]              @relation("AIPromptVersionReviewer")
  aiOperationsCreated        AIOperationDefinition[]        @relation("AIOperationCreator")
  aiExecutionsRequested      AIOperationExecution[]         @relation("AIExecutionRequester")
  aiApprovals                AIApproval[]                   @relation("AIApprovalReviewer")

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([marketId])
}

model ClientProfile {
  id                    String                 @id @default(uuid())
  userId                String                 @unique
  address               String?
  city                  String?
  state                 String?
  country               String
  postalCode            String?
  latitude              Float?
  longitude             Float?
  defaultPaymentMethod  PaymentMethod?
  totalBookings         Int                    @default(0)
  totalSpent            Decimal                @default(0.00) @db.Decimal(10, 2)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  paymentMethods        PaymentMethod[]
  bookings              Booking[]
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  favoriteProfessionals FavoriteProfessional[]
}

model ProfessionalProfile {
  id                     String                     @id @default(uuid())
  userId                 String                     @unique
  status                 ProfessionalStatus         @default(PENDING_REVIEW)
  bio                    String?
  yearsOfExperience      Int?
  hourlyRate             Decimal?                   @db.Decimal(10, 2)
  serviceRadius          Int?
  latitude               Float?
  longitude              Float?
  totalBookings          Int                        @default(0)
  totalEarnings          Decimal                    @default(0.00) @db.Decimal(10, 2)
  averageRating          Float                      @default(0.0)
  totalReviews           Int                        @default(0)
  verifiedAt             DateTime?
  rejectedReason         String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  stripeAccountId        String?                    @unique
  stripeTransfersStatus  String?
  stripeAccountUpdatedAt DateTime?
  bookings               Booking[]
  certifications         Certification[]
  documents              Document[]
  earnings               Earning[]
  favoriteedBy           FavoriteProfessional[]
  portfolio              Portfolio[]
  availability           ProfessionalAvailability[]
  categories             ProfessionalCategory[]
  user                   User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  services               Service[]
  marketingEvents        MarketingEvent[]
  errorEvents            ErrorEvent[]
  payouts                Payout[]
  disputes               Dispute[]
  growthLeads            Lead[]                     @relation("GrowthLeadProfessional")
  growthConversions      Conversion[]               @relation("GrowthConversionProfessional")
  serviceAreas           ProfessionalServiceArea[]

  @@index([status])
  @@index([userId])
}

model ProfessionalCategory {
  id              String              @id @default(uuid())
  professionalId  String
  categoryId      String
  yearsInCategory Int?
  verified        Boolean             @default(false)
  createdAt       DateTime            @default(now())
  category        Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  professional    ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, categoryId])
  @@index([professionalId])
  @@index([categoryId])
}

model Category {
  id              String                 @id @default(uuid())
  name            String                 @unique
  slug            String                 @unique
  description     String?
  iconUrl         String?
  isActive        Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  professionals   ProfessionalCategory[]
  services        Service[]
  subcategories   Subcategory[]
  contentVersions ContentVersion[]

  @@index([slug])
}

model Subcategory {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  categoryId  String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  services    Service[]
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([slug])
}

model Service {
  id                       String                    @id @default(uuid())
  name                     String
  description              String?
  basePrice                Decimal                   @db.Decimal(10, 2)
  duration                 Int
  categoryId               String
  subcategoryId            String?
  professionalId           String?
  isActive                 Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  bookingServices          BookingService[]
  category                 Category                  @relation(fields: [categoryId], references: [id])
  professional             ProfessionalProfile?      @relation(fields: [professionalId], references: [id])
  subcategory              Subcategory?              @relation(fields: [subcategoryId], references: [id])
  contentVersions          ContentVersion[]
  supplyDemandObservations SupplyDemandObservation[]
  supplyDemandSnapshots    SupplyDemandSnapshot[]
  expansionCandidates      ExpansionCandidate[]

  @@index([categoryId])
  @@index([professionalId])
}

model Booking {
  id                     String                    @id @default(uuid())
  clientId               String
  professionalId         String?
  status                 BookingStatus             @default(PENDING)
  scheduledDate          DateTime
  endDate                DateTime
  address                String
  city                   String
  state                  String
  postalCode             String
  latitude               Float?
  longitude              Float?
  notes                  String?
  totalPrice             Decimal                   @db.Decimal(10, 2)
  serviceAmount          Decimal                   @default(0.00) @db.Decimal(10, 2)
  platformFee            Decimal                   @default(0.00) @db.Decimal(10, 2)
  platformFeeState       PlatformFeeState          @default(PENDING)
  professionalCommission Decimal                   @default(0.00) @db.Decimal(10, 2)
  professionalEarnings   Decimal                   @db.Decimal(10, 2)
  currency               String
  pricingSnapshot        Json?
  pricingPolicyId        String?
  marketId               String?
  addressId              String?
  cancelledBy            String?
  cancellationReason     String?
  cancelledAt            DateTime?
  completedAt            DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  client                 ClientProfile             @relation(fields: [clientId], references: [id])
  professional           ProfessionalProfile?      @relation(fields: [professionalId], references: [id])
  bookingServices        BookingService[]
  notifications          Notification[]
  payment                Payment?
  review                 Review?
  marketingEvents        MarketingEvent[]
  errorEvents            ErrorEvent[]
  ledgerTransactions     LedgerTransaction[]
  refunds                Refund[]
  payout                 Payout?
  disputes               Dispute[]
  reconciliationItems    ReconciliationItem[]
  policyAcceptances      BookingPolicyAcceptance[]
  supportCases           SupportCase[]
  growthConversions      Conversion[]
  pricingPolicy          PricingPolicy?            @relation(fields: [pricingPolicyId], references: [id], onDelete: Restrict)
  market                 Market?                   @relation(fields: [marketId], references: [id], onDelete: Restrict)
  normalizedAddress      Address?                  @relation(fields: [addressId], references: [id], onDelete: Restrict)

  @@index([clientId])
  @@index([professionalId])
  @@index([status])
  @@index([scheduledDate])
  @@index([pricingPolicyId])
  @@index([marketId, status, scheduledDate])
  @@index([professionalId, status, scheduledDate, endDate])
  @@index([addressId])
}

model BookingService {
  id        String   @id @default(uuid())
  bookingId String
  serviceId String
  quantity  Int      @default(1)
  price     Decimal  @db.Decimal(10, 2)
  subtotal  Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id])

  @@unique([bookingId, serviceId])
  @@index([bookingId])
}

model Payment {
  id                 String              @id @default(uuid())
  bookingId          String              @unique
  amount             Decimal             @db.Decimal(10, 2)
  currency           String
  status             PaymentStatus       @default(PENDING)
  method             PaymentMethod
  transactionId      String?
  providerChargeId   String?             @unique
  processedAt        DateTime?
  failedReason       String?
  refundedAt         DateTime?
  refundAmount       Decimal?            @db.Decimal(10, 2)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  booking            Booking             @relation(fields: [bookingId], references: [id])
  ledgerTransactions LedgerTransaction[]
  refunds            Refund[]
  payout             Payout?
  disputes           Dispute[]

  @@index([bookingId])
  @@index([status])
}

model Earning {
  id             String              @id @default(uuid())
  professionalId String
  bookingId      String?
  amount         Decimal             @db.Decimal(10, 2)
  platformFee    Decimal             @db.Decimal(10, 2)
  netAmount      Decimal             @db.Decimal(10, 2)
  status         String              @default("PENDING")
  payoutDate     DateTime?
  createdAt      DateTime            @default(now())
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id])
  payout         Payout?

  @@index([professionalId])
  @@index([status])
}

model Review {
  id             String    @id @default(uuid())
  bookingId      String    @unique
  clientId       String
  professionalId String
  rating         Int
  comment        String?
  response       String?
  responseAt     DateTime?
  isVisible      Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  booking        Booking   @relation(fields: [bookingId], references: [id])
  client         User      @relation("ReviewGiven", fields: [clientId], references: [id])
  professional   User      @relation("ReviewReceived", fields: [professionalId], references: [id])

  @@index([professionalId])
  @@index([clientId])
  @@index([rating])
}

model Portfolio {
  id             String              @id @default(uuid())
  professionalId String
  imageUrl       String
  title          String?
  description    String?
  categoryId     String?
  displayOrder   Int                 @default(0)
  createdAt      DateTime            @default(now())
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id])

  @@index([professionalId])
}

model Certification {
  id             String              @id @default(uuid())
  professionalId String
  name           String
  issuer         String
  issueDate      DateTime
  expiryDate     DateTime?
  documentUrl    String
  verified       Boolean             @default(false)
  createdAt      DateTime            @default(now())
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id])

  @@index([professionalId])
}

model Document {
  id              String              @id @default(uuid())
  professionalId  String
  type            String
  documentUrl     String
  status          String              @default("PENDING_REVIEW")
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  expiresAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  professional    ProfessionalProfile @relation(fields: [professionalId], references: [id])

  @@index([professionalId])
  @@index([status])
}

model ProfessionalAvailability {
  id             String              @id @default(uuid())
  professionalId String
  dayOfWeek      Int
  startTime      String
  endTime        String
  isAvailable    Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id])

  @@index([professionalId])
}

model FavoriteProfessional {
  id             String              @id @default(uuid())
  clientId       String
  professionalId String
  createdAt      DateTime            @default(now())
  client         ClientProfile       @relation(fields: [clientId], references: [id])
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id])

  @@unique([clientId, professionalId])
  @@index([clientId])
  @@index([professionalId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  bookingId String?
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  booking   Booking?         @relation(fields: [bookingId], references: [id])
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([entityType, entityId])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model Role {
  id             String                   @id @default(uuid())
  key            String                   @unique
  name           String
  description    String?
  isSystem       Boolean                  @default(false)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  permissions    RolePermission[]
  assignments    UserRoleAssignment[]
  changeRequests AdminRoleChangeRequest[]
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRoleAssignment {
  id        String               @id @default(uuid())
  userId    String
  roleId    String
  status    RoleAssignmentStatus @default(ACTIVE)
  grantedBy String?
  grantedAt DateTime             @default(now())
  revokedAt DateTime?
  role      Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId, status])
  @@index([roleId, status])
}

model AdminSession {
  id               String             @id @default(uuid())
  userId           String
  refreshTokenHash String             @unique
  csrfTokenHash    String
  status           AdminSessionStatus @default(ACTIVE)
  expiresAt        DateTime
  lastSeenAt       DateTime           @default(now())
  revokedAt        DateTime?
  revocationReason String?
  userAgentHash    String?
  ipAddressHash    String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
  @@index([status, expiresAt])
}

model CustomerSession {
  id               String                 @id @default(uuid())
  userId           String
  status           CustomerSessionStatus  @default(ACTIVE)
  expiresAt        DateTime
  lastSeenAt       DateTime               @default(now())
  revokedAt        DateTime?
  revocationReason String?
  userAgentHash    String?
  ipAddressHash    String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens    CustomerRefreshToken[]

  @@index([userId, status, expiresAt])
  @@index([status, expiresAt])
}

model CustomerRefreshToken {
  id        String                     @id @default(uuid())
  sessionId String
  tokenHash String                     @unique
  status    CustomerRefreshTokenStatus @default(ACTIVE)
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime                   @default(now())
  session   CustomerSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status, expiresAt])
}

model AccountActionToken {
  id         String                   @id @default(uuid())
  userId     String
  type       AccountActionTokenType
  status     AccountActionTokenStatus @default(ACTIVE)
  tokenHash  String                   @unique
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime                 @default(now())
  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, status])
  @@index([type, status, expiresAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model AdminRoleChangeRequest {
  id             String                       @id @default(uuid())
  targetUserId   String
  roleId         String
  action         AdminRoleChangeAction
  status         AdminRoleChangeRequestStatus @default(REQUESTED)
  reason         String
  idempotencyKey String                       @unique
  requestedById  String
  requestedAt    DateTime                     @default(now())
  reviewedById   String?
  reviewedAt     DateTime?
  decisionReason String?
  executedAt     DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  targetUser     User                         @relation("AdminRoleTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  role           Role                         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  requestedBy    User                         @relation("AdminRoleRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy     User?                        @relation("AdminRoleReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([status, requestedAt])
  @@index([targetUserId, status, requestedAt])
  @@index([roleId, status])
}

model FeatureFlag {
  id          String            @id @default(uuid())
  key         String            @unique
  description String?
  status      FeatureFlagStatus @default(DISABLED)
  rules       Json?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
}

model Country {
  id                      String                   @id @default(uuid())
  isoAlpha2               String                   @unique @db.Char(2)
  isoAlpha3               String                   @unique @db.Char(3)
  isoNumeric              String                   @unique @db.Char(3)
  canonicalName           String
  lifecycle               CountryLifecycle         @default(ACTIVE)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  markets                 Market[]
  administrativeDivisions AdministrativeDivision[]
  geographyImports        GeographyDatasetImport[]
  addresses               Address[]
  identityDocuments       IdentityDocument[]

  @@index([lifecycle, isoAlpha2])
}

model Market {
  id                       String                         @id @default(uuid())
  code                     String                         @unique
  countryId                String
  status                   MarketStatus                   @default(DISABLED)
  currencyCode             String                         @db.Char(3)
  defaultLocale            String
  supportedLocales         String[]
  timezonePolicy           Json
  capabilities             Json
  currentPolicyVersion     Int?
  effectiveAt              DateTime?
  retiredAt                DateTime?
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt
  country                  Country                        @relation(fields: [countryId], references: [id], onDelete: Restrict)
  policies                 MarketPolicyVersion[]
  users                    User[]
  addresses                Address[]
  identityDocuments        IdentityDocument[]
  serviceAreas             ProfessionalServiceArea[]
  bookings                 Booking[]
  campaigns                Campaign[]
  leads                    Lead[]
  marketingEvents          MarketingEvent[]
  consentPolicies          ConsentPolicy[]
  pricingPolicies          PricingPolicy[]
  refundPolicies           RefundPolicy[]
  referrals                Referral[]
  referralProgramVersions  ReferralProgramVersionMarket[]
  experiments              Experiment[]
  contentEntries           ContentEntry[]
  contentVersions          ContentVersion[]
  sitemapSnapshots         SeoSitemapSnapshot[]
  supplyDemandObservations SupplyDemandObservation[]
  supplyDemandSnapshots    SupplyDemandSnapshot[]
  readinessPolicies        MarketReadinessPolicy[]
  readinessEvaluations     MarketReadinessEvaluation[]
  expansionCandidates      ExpansionCandidate[]
  aiExecutions             AIOperationExecution[]
  aiCostRecords            AICostRecord[]

  @@unique([countryId, code])
  @@index([status, effectiveAt])
  @@index([countryId, status])
}

model MarketPolicyVersion {
  id                     String              @id @default(uuid())
  marketId               String
  version                Int
  status                 MarketPolicyStatus  @default(DRAFT)
  identityPolicy         Json
  geographyPolicy        Json
  addressPolicy          Json
  localePolicy           Json
  currencyPolicy         Json
  legalPolicyReferences  Json
  taxPolicyReference     Json?
  paymentPolicyReference Json?
  schemaDigest           String
  reviewStatus           LegalReviewStatus   @default(PENDING)
  reviewReference        String?
  reviewedBy             String?
  reviewedAt             DateTime?
  effectiveAt            DateTime?
  retiredAt              DateTime?
  createdBy              String?
  createdAt              DateTime            @default(now())
  market                 Market              @relation(fields: [marketId], references: [id], onDelete: Restrict)
  experimentVersions     ExperimentVersion[]
  contentVersions        ContentVersion[]

  @@unique([marketId, version])
  @@index([marketId, status, effectiveAt])
  @@index([schemaDigest])
}

model GeographyDatasetImport {
  id              String                         @id @default(uuid())
  countryId       String
  sourceKey       String
  sourceUrl       String
  sourceVersion   String
  referenceDate   DateTime
  retrievedAt     DateTime
  checksumSha256  String
  parserVersion   String
  status          GeographyImportStatus          @default(PENDING)
  rowCount        Int                            @default(0)
  insertedCount   Int                            @default(0)
  updatedCount    Int                            @default(0)
  deprecatedCount Int                            @default(0)
  errorCategory   String?
  evidence        Json?
  requestId       String?
  correlationId   String?
  traceId         String?
  createdAt       DateTime                       @default(now())
  completedAt     DateTime?
  country         Country                        @relation(fields: [countryId], references: [id], onDelete: Restrict)
  divisions       AdministrativeDivision[]
  changes         AdministrativeDivisionChange[]

  @@unique([countryId, sourceKey, sourceVersion, checksumSha256])
  @@index([countryId, sourceKey, status, createdAt])
  @@index([correlationId])
}

model AdministrativeDivision {
