// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  CLIENT
  PROFESSIONAL
  ADMIN
}

enum ProfessionalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  PAYPAL
  STRIPE
  CASH
}

enum NotificationType {
  BOOKING_REQUEST
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  PAYMENT_RECEIVED
  REMINDER
  PROMOTION
  SYSTEM
}

// ============================================
// MODELOS PRINCIPALES
// ============================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  avatarUrl     String?   // Cloudinary URL para foto de perfil
  role          UserRole  @default(CLIENT)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  // Relaciones
  clientProfile ClientProfile?
  professionalProfile ProfessionalProfile?
  notifications Notification[]
  reviewsGiven    Review[] @relation("ReviewGiven")
  reviewsReceived Review[] @relation("ReviewReceived")
  
  @@index([email])
  @@index([phone])
  @@index([role])
}

model ClientProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address         String?
  city            String?
  state           String?
  country         String  @default("MX")
  postalCode      String?
  latitude        Float?
  longitude       Float?
  defaultPaymentMethod PaymentMethod?
  totalBookings   Int      @default(0)
  totalSpent      Decimal  @default(0.00) @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relaciones
  bookings        Booking[]
  favoriteProfessionals FavoriteProfessional[]
  paymentMethods  PaymentMethod[]
}

model ProfessionalProfile {
  id                    String             @id @default(uuid())
  userId                String             @unique
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                ProfessionalStatus @default(PENDING_REVIEW)
  bio                   String?
  yearsOfExperience     Int?
  hourlyRate            Decimal?           @db.Decimal(10, 2)
  serviceRadius         Int?               // en kilómetros
  latitude              Float?
  longitude             Float?
  totalBookings         Int                @default(0)
  totalEarnings         Decimal            @default(0.00) @db.Decimal(10, 2)
  averageRating         Float              @default(0.0)
  totalReviews          Int                @default(0)
  verifiedAt            DateTime?
  rejectedReason        String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  // Relaciones
  categories            ProfessionalCategory[]
  services              Service[]
  bookings              Booking[]
  portfolio             Portfolio[]
  certifications        Certification[]
  availability          ProfessionalAvailability[]
  favoriteedBy          FavoriteProfessional[]
  earnings              Earning[]
  documents             Document[]
  
  @@index([status])
  @@index([userId])
}

model ProfessionalCategory {
  id                String   @id @default(uuid())
  professionalId    String
  categoryId        String
  professional      ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  category          Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  yearsInCategory   Int?
  verified          Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@unique([professionalId, categoryId])
  @@index([professionalId])
  @@index([categoryId])
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  iconUrl     String?  // Cloudinary URL para ícono de categoría
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  professionals ProfessionalCategory[]
  services      Service[]
  subcategories Subcategory[]
  
  @@index([slug])
}

model Subcategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  services    Service[]
  
  @@index([categoryId])
  @@index([slug])
}

model Service {
  id            String   @id @default(uuid())
  name          String
  description   String?
  basePrice     Decimal  @db.Decimal(10, 2)
  duration      Int      // duración estimada en minutos
  categoryId    String
  subcategoryId String?
  category      Category @relation(fields: [categoryId], references: [id])
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])
  professionalId String?
  professional  ProfessionalProfile? @relation(fields: [professionalId], references: [id])
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relaciones
  bookingServices BookingService[]
  
  @@index([categoryId])
  @@index([professionalId])
}

model Booking {
  id                String        @id @default(uuid())
  clientId          String
  professionalId    String?
  client            ClientProfile @relation(fields: [clientId], references: [id])
  professional      ProfessionalProfile? @relation(fields: [professionalId], references: [id])
  status            BookingStatus @default(PENDING)
  scheduledDate     DateTime
  endDate           DateTime?
  address           String
  city              String
  state             String
  postalCode        String
  latitude          Float?
  longitude         Float?
  notes             String?
  totalPrice        Decimal       @db.Decimal(10, 2)
  platformFee       Decimal       @default(0.00) @db.Decimal(10, 2)
  professionalEarnings Decimal    @db.Decimal(10, 2)
  cancelledBy       String?       // CLIENT o PROFESSIONAL
  cancellationReason String?
  cancelledAt       DateTime?
  completedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relaciones
  bookingServices   BookingService[]
  payment           Payment?
  review            Review?
  notifications     Notification[]
  
  @@index([clientId])
  @@index([professionalId])
  @@index([status])
  @@index([scheduledDate])
}

model BookingService {
  id          String   @id @default(uuid())
  bookingId   String
  serviceId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service     Service  @relation(fields: [serviceId], references: [id])
  quantity    Int      @default(1)
  price       Decimal  @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  @@unique([bookingId, serviceId])
  @@index([bookingId])
}

model Payment {
  id              String        @id @default(uuid())
  bookingId       String        @unique
  booking         Booking       @relation(fields: [bookingId], references: [id])
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("MXN")
  status          PaymentStatus @default(PENDING)
  method          PaymentMethod
  transactionId   String?       // ID de la pasarela de pago (Stripe, PayPal, etc.)
  processedAt     DateTime?
  failedReason    String?
  refundedAt      DateTime?
  refundAmount    Decimal?      @db.Decimal(10, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([bookingId])
  @@index([status])
}

model Earning {
  id              String   @id @default(uuid())
  professionalId  String
  professional    ProfessionalProfile @relation(fields: [professionalId], references: [id])
  bookingId       String?
  amount          Decimal  @db.Decimal(10, 2)
  platformFee     Decimal  @db.Decimal(10, 2)
  netAmount       Decimal  @db.Decimal(10, 2)
  status          String   @default("PENDING") // PENDING, PAID, HOLD
  payoutDate      DateTime?
  createdAt       DateTime @default(now())

  @@index([professionalId])
  @@index([status])
}

model Review {
  id              String   @id @default(uuid())
  bookingId       String   @unique
  booking         Booking  @relation(fields: [bookingId], references: [id])
  clientId        String
  professionalId  String
  client          User     @relation("ReviewGiven", fields: [clientId], references: [id])
  professional    User     @relation("ReviewReceived", fields: [professionalId], references: [id])
  rating          Int      // 1-5 estrellas
  comment         String?
  response        String?  // Respuesta del profesional
  responseAt      DateTime?
  isVisible       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([professionalId])
  @@index([clientId])
  @@index([rating])
}

model Portfolio {
  id              String   @id @default(uuid())
  professionalId  String
  professional    ProfessionalProfile @relation(fields: [professionalId], references: [id])
  imageUrl        String   // Cloudinary URL
  title           String?
  description     String?
  categoryId      String?
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([professionalId])
}

model Certification {
  id              String   @id @default(uuid())
  professionalId  String
  professional    ProfessionalProfile @relation(fields: [professionalId], references: [id])
  name            String
  issuer          String
  issueDate       DateTime
  expiryDate      DateTime?
  documentUrl     String   // Cloudinary URL del certificado
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([professionalId])
}

model Document {
  id              String   @id @default(uuid())
  professionalId  String
  professional    ProfessionalProfile @relation(fields: [professionalId], references: [id])
  type            String   // BACKGROUND_CHECK, ID, CERTIFICATION, etc.
  documentUrl     String   // Cloudinary URL
  status          String   @default("PENDING_REVIEW") // PENDING_REVIEW, APPROVED, REJECTED
  reviewedBy      String?  // Admin ID
  reviewedAt      DateTime?
  rejectionReason String?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([professionalId])
  @@index([status])
}

model ProfessionalAvailability {
  id              String   @id @default(uuid())
  professionalId  String
  professional    ProfessionalProfile @relation(fields: [professionalId], references: [id])
  dayOfWeek       Int      // 0-6 (Domingo-Sábado)
  startTime       String   // Formato HH:mm
  endTime         String   // Formato HH:mm
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([professionalId])
}

model FavoriteProfessional {
  id              String   @id @default(uuid())
  clientId        String
  professionalId  String
  client          ClientProfile @relation(fields: [clientId], references: [id])
  professional    ProfessionalProfile @relation(fields: [professionalId], references: [id])
  createdAt       DateTime @default(now())

  @@unique([clientId, professionalId])
  @@index([clientId])
  @@index([professionalId])
}

model Notification {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId       String?
  booking         Booking? @relation(fields: [bookingId], references: [id])
  type            NotificationType
  title           String
  message         String
  data            Json?    // Datos adicionales en formato JSON
  isRead          Boolean  @default(false)
  readAt          DateTime?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model AdminAuditLog {
  id              String   @id @default(uuid())
  adminId         String
  action          String   // DOCUMENT_APPROVED, PROFESSIONAL_VERIFIED, etc.
  entityType      String   // PROFESSIONAL, DOCUMENT, BOOKING, etc.
  entityId        String
  oldValue        Json?
  newValue        Json?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())

  @@index([adminId])
  @@index([entityType, entityId])
}

model SystemSetting {
  id              String   @id @default(uuid())
  key             String   @unique
  value           Json
  description     String?
  updatedAt       DateTime @updatedAt

  @@index([key])
}
