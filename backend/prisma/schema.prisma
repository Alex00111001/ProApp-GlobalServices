model ErrorEvent {
  id                    String               @id @default(uuid())
  errorGroupId          String
  fingerprint           String
  severity              ErrorSeverity        @default(ERROR)
  environment           String
  service               String
  module                String?
  operation             String?
  errorCode             String?
  message               String
  stackTrace            String?
  httpStatus            Int?
  endpoint              String?
  method                String?
  userId                String?
  professionalId        String?
  bookingId             String?
  requestId             String?
  correlationId         String?
  traceId               String?
  appVersion            String?
  device                Json?
  metadata              Json?
  occurredAt            DateTime             @default(now())
  legacyFirstSeenAt     DateTime             @default(now()) @map("firstSeenAt")
  legacyLastSeenAt      DateTime             @default(now()) @map("lastSeenAt")
  legacyOccurrenceCount Int                  @default(1) @map("occurrenceCount")
  legacyStatus          ErrorStatus          @default(OPEN) @map("status")
