generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  phone               String               @unique
  passwordHash        String
  firstName           String
  lastName            String
  avatarUrl           String?
  role                UserRole             @default(CLIENT)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  lastLoginAt         DateTime?
  countryCode         String               @default("ES")
  termsAcceptedAt     DateTime?
  termsVersion        String?
  privacyAcceptedAt   DateTime?
  privacyVersion      String?
  marketingConsentAt  DateTime?
  registrationLocale  String?
  clientProfile       ClientProfile?
  notifications       Notification[]
  professionalProfile ProfessionalProfile?
  reviewsGiven        Review[]             @relation("ReviewGiven")
  reviewsReceived     Review[]             @relation("ReviewReceived")
  administrativeRoles UserRoleAssignment[]
  auditLogs           AuditLog[]           @relation("AuditActor")
  marketingEvents     MarketingEvent[]
  errorEvents         ErrorEvent[]
  incidentComments    IncidentComment[]

  @@index([email])
  @@index([phone])
  @@index([role])
}

model ClientProfile {
  id                    String                 @id @default(uuid())
  userId                String                 @unique
  address               String?
  city                  String?
  state                 String?
  country               String                 @default("MX")
  postalCode            String?
  latitude              Float?
  longitude             Float?
  defaultPaymentMethod  PaymentMethod?
  totalBookings         Int                    @default(0)
  totalSpent            Decimal                @default(0.00) @db.Decimal(10, 2)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  paymentMethods        PaymentMethod[]
  bookings              Booking[]
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  favoriteProfessionals FavoriteProfessional[]
}

model ProfessionalProfile {
  id                String                     @id @default(uuid())
  userId            String                     @unique
  status            ProfessionalStatus         @default(PENDING_REVIEW)
  bio               String?
  yearsOfExperience Int?
  hourlyRate        Decimal?                   @db.Decimal(10, 2)
  serviceRadius     Int?
  latitude          Float?
  longitude         Float?
  totalBookings     Int                        @default(0)
  totalEarnings     Decimal                    @default(0.00) @db.Decimal(10, 2)
  averageRating     Float                      @default(0.0)
  totalReviews      Int                        @default(0)
  verifiedAt        DateTime?
  rejectedReason    String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  bookings          Booking[]
  certifications    Certification[]
  documents         Document[]
  earnings          Earning[]
  favoriteedBy      FavoriteProfessional[]
  portfolio         Portfolio[]
  availability      ProfessionalAvailability[]
  categories        ProfessionalCategory[]
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  services          Service[]
  marketingEvents   MarketingEvent[]
  errorEvents       ErrorEvent[]

  @@index([status])
  @@index([userId])
}

model ProfessionalCategory {
  id              String              @id @default(uuid())
  professionalId  String
  categoryId      String
  yearsInCategory Int?
  verified        Boolean             @default(false)
  createdAt       DateTime            @default(now())
  category        Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  professional    ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, categoryId])
  @@index([professionalId])
  @@index([categoryId])
}

model Category {
  id            String                 @id @default(uuid())
  name          String                 @unique
  slug          String                 @unique
  description   String?
  iconUrl       String?
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  professionals ProfessionalCategory[]
  services      Service[]
  subcategories Subcategory[]

  @@index([slug])
}

model Subcategory {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  categoryId  String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  services    Service[]
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([slug])
}

model Service {
  id              String               @id @default(uuid())
  name            String
  description     String?
  basePrice       Decimal              @db.Decimal(10, 2)
  duration        Int
  categoryId      String
  subcategoryId   String?
  professionalId  String?
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  bookingServices BookingService[]
  category        Category             @relation(fields: [categoryId], references: [id])
  professional    ProfessionalProfile? @relation(fields: [professionalId], references: [id])
  subcategory     Subcategory?         @relation(fields: [subcategoryId], references: [id])

  @@index([categoryId])
  @@index([professionalId])
}

model Booking {
  id                   String               @id @default(uuid())
  clientId             String
  professionalId       String?
  status               BookingStatus        @default(PENDING)
  scheduledDate        DateTime
  endDate              DateTime?
  address              String
  city                 String
  state                String
  postalCode           String
  latitude             Float?
  longitude            Float?
  notes                String?
  totalPrice           Decimal              @db.Decimal(10, 2)
  platformFee          Decimal              @default(0.00) @db.Decimal(10, 2)
  professionalEarnings Decimal              @db.Decimal(10, 2)
  cancelledBy          String?
  cancellationReason   String?
  cancelledAt          DateTime?
  completedAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  client               ClientProfile        @relation(fields: [clientId], references: [id])
  professional         ProfessionalProfile? @relation(fields: [professionalId], references: [id])
  bookingServices      BookingService[]
  notifications        Notification[]
  payment              Payment?
  review               Review?
  marketingEvents      MarketingEvent[]
  errorEvents          ErrorEvent[]

  @@index([clientId])
  @@index([professionalId])
  @@index([status])
  @@index([scheduledDate])
}

model BookingService {
  id        String   @id @default(uuid())
  bookingId String
  serviceId String
  quantity  Int      @default(1)
  price     Decimal  @db.Decimal(10, 2)
  subtotal  Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id])

  @@unique([bookingId, serviceId])
  @@index([bookingId])
}

model Payment {
  id            String        @id @default(uuid())
  bookingId     String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("MXN")
  status        PaymentStatus @default(PENDING)
  method        PaymentMethod
  transactionId String?
  processedAt   DateTime?
  failedReason  String?
  refundedAt    DateTime?
  refundAmount  Decimal?      @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  booking       Booking       @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([status])
}

model Earning {
  id             String              @id @default(uuid())
  professionalId String
  bookingId      String?
  amount         Decimal             @db.Decimal(10, 2)
  platformFee    Decimal             @db.Decimal(10, 2)
  netAmount      Decimal             @db.Decimal(10, 2)
  status         String              @default("PENDING")
  payoutDate     DateTime?
  createdAt      DateTime            @default(now())
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id])

  @@index([professionalId])
  @@index([status])
}

model Review {
  id             String    @id @default(uuid())
  bookingId      String    @unique
  clientId       String
  professionalId String
  rating         Int
  comment        String?
  response       String?
  responseAt     DateTime?
  isVisible      Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  booking        Booking   @relation(fields: [bookingId], references: [id])
  client         User      @relation("ReviewGiven", fields: [clientId], references: [id])
  professional   User      @relation("ReviewReceived", fields: [professionalId], references: [id])

  @@index([professionalId])
  @@index([clientId])
  @@index([rating])
}

model Portfolio {
  id             String              @id @default(uuid())
  professionalId String
  imageUrl       String
  title          String?
  description    String?
  categoryId     String?
  displayOrder   Int                 @default(0)
  createdAt      DateTime            @default(now())
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id])

  @@index([professionalId])
}

model Certification {
  id             String              @id @default(uuid())
  professionalId String
  name           String
  issuer         String
  issueDate      DateTime
  expiryDate     DateTime?
  documentUrl    String
  verified       Boolean             @default(false)
  createdAt      DateTime            @default(now())
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id])

  @@index([professionalId])
}

model Document {
  id              String              @id @default(uuid())
  professionalId  String
  type            String
  documentUrl     String
  status          String              @default("PENDING_REVIEW")
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  expiresAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  professional    ProfessionalProfile @relation(fields: [professionalId], references: [id])

  @@index([professionalId])
  @@index([status])
}

model ProfessionalAvailability {
  id             String              @id @default(uuid())
  professionalId String
  dayOfWeek      Int
  startTime      String
  endTime        String
  isAvailable    Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id])

  @@index([professionalId])
}

model FavoriteProfessional {
  id             String              @id @default(uuid())
  clientId       String
  professionalId String
  createdAt      DateTime            @default(now())
  client         ClientProfile       @relation(fields: [clientId], references: [id])
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id])

  @@unique([clientId, professionalId])
  @@index([clientId])
  @@index([professionalId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  bookingId String?
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  booking   Booking?         @relation(fields: [bookingId], references: [id])
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([entityType, entityId])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model Role {
  id          String               @id @default(uuid())
  key         String               @unique
  name        String
  description String?
  isSystem    Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  permissions RolePermission[]
  assignments UserRoleAssignment[]
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRoleAssignment {
  id        String               @id @default(uuid())
  userId    String
  roleId    String
  status    RoleAssignmentStatus @default(ACTIVE)
  grantedBy String?
  grantedAt DateTime             @default(now())
  revokedAt DateTime?
  role      Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId, status])
  @@index([roleId, status])
}

model FeatureFlag {
  id          String            @id @default(uuid())
  key         String            @unique
  description String?
  status      FeatureFlagStatus @default(DISABLED)
  rules       Json?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
}

model AuditLog {
  id            String       @id @default(uuid())
  actorId       String?
  action        String
  resourceType  String
  resourceId    String?
  outcome       AuditOutcome @default(SUCCESS)
  reason        String?
  before        Json?
  after         Json?
  requestId     String?
  correlationId String?
  traceId       String?
  ipAddress     String?
  userAgent     String?
  metadata      Json?
  createdAt     DateTime     @default(now())
  actor         User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([correlationId])
  @@index([createdAt])
}

model IdempotencyRecord {
  id             String            @id @default(uuid())
  scope          String
  key            String
  requestHash    String
  status         IdempotencyStatus @default(PROCESSING)
  responseStatus Int?
  responseBody   Json?
  lockedAt       DateTime          @default(now())
  completedAt    DateTime?
  expiresAt      DateTime
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([scope, key])
  @@index([status, lockedAt])
  @@index([expiresAt])
}

model OutboxEvent {
  id            String       @id @default(uuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  metadata      Json?
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now())
  lockedAt      DateTime?
  processedAt   DateTime?
  lastError     String?
  createdAt     DateTime     @default(now())

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@index([eventType, createdAt])
}

model MarketingEvent {
  id             String               @id @default(uuid())
  eventName      String
  occurredAt     DateTime
  receivedAt     DateTime             @default(now())
  userId         String?
  professionalId String?
  bookingId      String?
  sessionId      String?
  anonymousId    String?
  source         String?
  channel        String?
  campaign       String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  device         Json?
  appVersion     String?
  geography      Json?
  metadata       Json?
  booking        Booking?             @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  professional   ProfessionalProfile? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventName, occurredAt])
  @@index([userId, occurredAt])
  @@index([professionalId, occurredAt])
  @@index([bookingId, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([anonymousId, occurredAt])
  @@index([utmCampaign, occurredAt])
}

model ErrorEvent {
  id              String               @id @default(uuid())
  fingerprint     String               @unique
  severity        ErrorSeverity        @default(ERROR)
  environment     String
  service         String
  module          String?
  operation       String?
  errorCode       String?
  message         String
  stackTrace      String?
  httpStatus      Int?
  endpoint        String?
  method          String?
  userId          String?
  professionalId  String?
  bookingId       String?
  requestId       String?
  correlationId   String?
  traceId         String?
  appVersion      String?
  device          Json?
  metadata        Json?
  firstSeenAt     DateTime             @default(now())
  lastSeenAt      DateTime             @default(now())
  occurrenceCount Int                  @default(1)
  status          ErrorStatus          @default(OPEN)
  user            User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  professional    ProfessionalProfile? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  booking         Booking?             @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  incidentEvents  IncidentEvent[]

  @@index([severity, status, lastSeenAt])
  @@index([service, lastSeenAt])
  @@index([correlationId])
  @@index([bookingId, lastSeenAt])
}

model Incident {
  id             String            @id @default(uuid())
  title          String
  description    String?
  status         IncidentStatus    @default(OPEN)
  severity       IncidentSeverity  @default(MEDIUM)
  service        String?
  assigneeId     String?
  detectedAt     DateTime          @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  events         IncidentEvent[]
  comments       IncidentComment[]

  @@index([status, severity, detectedAt])
  @@index([service, status])
}

model IncidentEvent {
  id           String      @id @default(uuid())
  incidentId   String
  errorEventId String?
  eventType    String
  message      String?
  metadata     Json?
  createdAt    DateTime    @default(now())
  incident     Incident    @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  errorEvent   ErrorEvent? @relation(fields: [errorEventId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@index([errorEventId])
}

model IncidentComment {
  id         String   @id @default(uuid())
  incidentId String
  authorId   String?
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@index([authorId])
}

model ServiceHealthSnapshot {
  id        String       @id @default(uuid())
  service   String
  status    HealthStatus
  latencyMs Int?
  message   String?
  metadata  Json?
  checkedAt DateTime     @default(now())

  @@index([service, checkedAt])
  @@index([status, checkedAt])
}

enum UserRole {
  CLIENT
  PROFESSIONAL
  ADMIN
}

enum ProfessionalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  PAYPAL
  STRIPE
  CASH
}

enum NotificationType {
  BOOKING_REQUEST
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  PAYMENT_RECEIVED
  REMINDER
  PROMOTION
  SYSTEM
}

enum RoleAssignmentStatus {
  ACTIVE
  REVOKED
}

enum FeatureFlagStatus {
  DISABLED
  ENABLED
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER
}

enum ErrorSeverity {
  DEBUG
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum ErrorStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  IGNORED
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
  CLOSED
}

enum IncidentSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum HealthStatus {
  HEALTHY
  DEGRADED
  OUTAGE
  UNKNOWN
}
