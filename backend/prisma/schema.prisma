  @@index([errorGroupId, occurredAt])
  @@index([fingerprint, occurredAt])
  @@index([severity, occurredAt])
  @@index([service, occurredAt])
  @@index([severity, legacyStatus, legacyLastSeenAt], map: "ErrorEvent_severity_status_lastSeenAt_idx")
  @@index([service, legacyLastSeenAt], map: "ErrorEvent_service_lastSeenAt_idx")
  @@index([correlationId])
  @@index([bookingId, occurredAt])
  @@index([bookingId, legacyLastSeenAt], map: "ErrorEvent_bookingId_lastSeenAt_idx")
